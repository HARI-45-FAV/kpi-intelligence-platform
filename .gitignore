# Local data: platform DB, uploaded documents, test scratch
backend/data/
backend/tests/_tmp/
# pytest's default tmp root is a junction under AppData that Windows refuses to
# unlink at teardown, so runs here pass --basetemp=.pytest-tmp instead.
backend/.pytest-tmp/
*.log

# Secrets — never commit
.env
*.env
!.env.example

