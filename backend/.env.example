# Platform metadata database.
# SQLite by default (zero setup). Point at Postgres/Supabase to deploy:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres
# This is OUR metadata only. Tenant business data is registered at runtime
# through the Data Source Registry, never configured here.
# DATABASE_URL=sqlite:///./data/platform.db

# Signs access tokens. Nothing else.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Safe to rotate: everyone signs in again, and nothing stored becomes unreadable.
SECRET_KEY=change-me-to-a-long-random-value

# Seals stored data-source credentials. Separate from SECRET_KEY on purpose --
# rotate this and every registered data source in every company stops being
# readable, so it has its own lifecycle and its own backup.
# Leave it unset and SECRET_KEY is used, which is what older installs did; set it
# and existing credentials are re-sealed under it once, at boot.
# CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-different-long-random-value

# Outside development ("production", "staging", anything not development/test/
# local) the app refuses to start on the shipped default SECRET_KEY or on one
# shorter than 32 characters, and it stops serving /docs and /redoc.
ENVIRONMENT=development
DEBUG=true
ACCESS_TOKEN_TTL_MINUTES=720

# Guard rails on connector work
CONNECTOR_QUERY_TIMEOUT_SECONDS=30
CONNECTOR_MAX_ROWS_RETURNED=5000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Optional AI Copilot layer
# ---------------------------------------------------------------------------
# The platform is complete without this. With LLM_ENABLED=false the app starts
# normally, every deterministic endpoint behaves identically, no AI package is
# imported, no model is contacted, and the Copilot API reports an explicit
# "unavailable" state instead of guessing.
LLM_ENABLED=false

# Transport implementation in app/llm, and the only line that changes when the
# model behind the Copilot changes:
#   gemini             -- Google's hosted generateContent API (see GEMINI_* below)
#   openai_compatible  -- the OpenAI chat-completions shape, served by vLLM,
#                         llama.cpp, Ollama, TGI or OpenAI itself
# Nothing outside app/llm knows which of them answered.
LLM_PROVIDER=gemini

# ---- Gemini (LLM_PROVIDER=gemini) -----------------------------------------
# Backend-only credentials. The key is read here, held in the API process and
# sent to Google in a request header; it is never returned by an endpoint,
# written to a log or audit entry, or exposed to the browser. The frontend asks
# the backend for an answer and receives the answer, never the key.
# Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave blank for the current default (gemini-2.5-flash). gemini-2.5-pro answers
# a governed-analysis question more carefully and costs more per call.
GEMINI_MODEL=
# Optional: pin an API version. Blank uses Google's documented v1beta endpoint.
GEMINI_BASE_URL=

# ---- OpenAI-compatible endpoint (LLM_PROVIDER=openai_compatible) ----------
# Ignored while LLM_PROVIDER=gemini, and kept ready for switching back. For a
# local Qwen served by vLLM:
#   python -m vllm.entrypoints.openai.api_server \
#     --model Qwen/Qwen3-30B-A3B-Instruct-2507 --port 8000
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# For a local Ollama instead, the /v1 suffix is what makes it OpenAI-compatible
# (bare :11434 is Ollama's own API and returns 404 for /chat/completions):
#   ollama pull qwen3:8b
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:8b
# Verify a live endpoint end to end with:  python verify_ollama.py
# The Gemini equivalent is:                python verify_gemini.py

LLM_TEMPERATURE=0.1
# qwen3 is a reasoning model and its thinking is billed to this budget before
# any answer is produced, so a value tuned for a non-reasoning model can return
# a finish_reason of "length" with empty content. 1200 suits a served 30B;
# allow ~2400 for qwen3:8b. Gemini 2.5 also thinks before answering and charges
# it to this budget, so the same reasoning applies -- 1200 is a working value
# for flash, and LLM_REASONING_EFFORT=none removes the overhead entirely.
LLM_MAX_OUTPUT_TOKENS=1200
# One model call, not one Copilot turn. A turn may take up to
# LLM_MAX_TOOL_ITERATIONS + 1 calls, so budget wall-clock accordingly. 90s suits
# a GPU-served model; a quantised 8B on consumer hardware needs far more -- the
# Copilot prompt carries every governed tool schema, and thinking runs before
# the first output token.
LLM_REQUEST_TIMEOUT_SECONDS=90
# ``none`` stops a reasoning model spending the output budget on hidden
# deliberation: local Qwen3 disables thinking, and Gemini 2.5 Flash is asked for
# a zero thinking budget. Leave blank for providers that do not support it, and
# for gemini-2.5-pro, which cannot turn thinking off.
LLM_REASONING_EFFORT=
# Set false for a small local model that cannot reliably complete tool-call
# planning. Retrieval and all normal platform APIs remain available.
LLM_TOOL_CALLING_ENABLED=true
# Tool-calling rounds allowed per Copilot turn before it answers with what it has.
LLM_MAX_TOOL_ITERATIONS=4

# Cost accounting written to execution_logs.estimated_cost_usd.
# Zero is correct for a self-hosted model. A hosted one bills per token, so fill
# these from the provider's current pricing to have the figure mean something.
LLM_INPUT_COST_PER_1K_USD=0.0
LLM_OUTPUT_COST_PER_1K_USD=0.0

# Copilot retrieval bounds. Retrieval covers governed platform metadata and
# documents the caller may read -- never tenant business rows.
COPILOT_RETRIEVAL_TOP_K=8
COPILOT_CHUNK_CHARS=1200
COPILOT_MAX_DOCUMENT_BYTES_SCANNED=2097152
# How far back a recorded business event stays relevant to a retrieved question.
COPILOT_EVENT_RELEVANCE_DAYS=45

# ---------------------------------------------------------------------------
# Post-run email
# ---------------------------------------------------------------------------
# A completed Agent Run can be mailed out as a summary of what it already
# stored. The platform is complete without this: with EMAIL_ENABLED=false a run
# finishes exactly as before and reports "not sent" with the reason, rather than
# failing.
#
# Nothing is recomputed to write the mail -- it renders the stored detection
# rows and the same explanation the Results screen shows, so the two cannot
# disagree. One mail per Agent Run: reopening a completed date sends nothing,
# and an authorised re-run is a new run, so it sends its own.
EMAIL_ENABLED=false
# smtp is the only transport this build implements.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on the port above. Keep true for anything crossing a network.
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=20
EMAIL_FROM=
# Fallback only, comma-separated, and normally left empty. A run summary is
# addressed to the company's own registered users -- the active members whose role
# grants both analytics.read and investigation.read, resolved from the membership
# table at send time -- so adding an analyst to a company adds them to its
# summaries with no change here. This list is used only when a company has no such
# member, which is the one case where a deployment-wide answer is the right one.
EMAIL_RECIPIENTS=
EMAIL_SUBJECT_PREFIX=[KPI Intelligence]
