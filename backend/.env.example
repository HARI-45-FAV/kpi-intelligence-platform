# Platform metadata database.
# SQLite by default (zero setup). Point at Postgres/Supabase to deploy:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres
# This is OUR metadata only. Tenant business data is registered at runtime
# through the Data Source Registry, never configured here.
# DATABASE_URL=sqlite:///./data/platform.db

# Signs access tokens. Nothing else.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Safe to rotate: everyone signs in again, and nothing stored becomes unreadable.
SECRET_KEY=change-me-to-a-long-random-value

# Seals stored data-source credentials. Separate from SECRET_KEY on purpose --
# rotate this and every registered data source in every company stops being
# readable, so it has its own lifecycle and its own backup.
# Leave it unset and SECRET_KEY is used, which is what older installs did; set it
# and existing credentials are re-sealed under it once, at boot.
# CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-different-long-random-value

# Outside development ("production", "staging", anything not development/test/
# local) the app refuses to start on the shipped default SECRET_KEY or on one
# shorter than 32 characters, and it stops serving /docs and /redoc.
ENVIRONMENT=development
DEBUG=true
ACCESS_TOKEN_TTL_MINUTES=720

# Guard rails on connector work
CONNECTOR_QUERY_TIMEOUT_SECONDS=30
CONNECTOR_MAX_ROWS_RETURNED=5000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Optional AI Copilot layer
# ---------------------------------------------------------------------------
# The platform is complete without this. With LLM_ENABLED=false the app starts
# normally, every deterministic endpoint behaves identically, no AI package is
# imported, no model is contacted, and the Copilot API reports an explicit
# "unavailable" state instead of guessing.
LLM_ENABLED=false

# Transport implementation in app/llm. "openai_compatible" speaks the OpenAI
# chat-completions shape, which vLLM, llama.cpp, Ollama, TGI and OpenAI all
# serve -- so nothing outside app/llm knows which model answers.
LLM_PROVIDER=openai_compatible

# Where the model is served. For a local Qwen served by vLLM:
#   python -m vllm.entrypoints.openai.api_server \
#     --model Qwen/Qwen3-30B-A3B-Instruct-2507 --port 8000
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# For a local Ollama instead, the /v1 suffix is what makes it OpenAI-compatible
# (bare :11434 is Ollama's own API and returns 404 for /chat/completions):
#   ollama pull qwen3:8b
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3:8b
# Verify a live endpoint end to end with:  python verify_ollama.py

LLM_TEMPERATURE=0.1
# qwen3 is a reasoning model and its thinking is billed to this budget before
# any answer is produced, so a value tuned for a non-reasoning model can return
# a finish_reason of "length" with empty content. 1200 suits a served 30B;
# allow ~2400 for qwen3:8b.
LLM_MAX_OUTPUT_TOKENS=1200
# One model call, not one Copilot turn. A turn may take up to
# LLM_MAX_TOOL_ITERATIONS + 1 calls, so budget wall-clock accordingly. 90s suits
# a GPU-served model; a quantised 8B on consumer hardware needs far more -- the
# Copilot prompt carries every governed tool schema, and thinking runs before
# the first output token.
LLM_REQUEST_TIMEOUT_SECONDS=90
# For local Qwen3 via Ollama, set this to ``none`` so hidden reasoning does not
# consume the output budget. Leave blank for providers that do not support it.
LLM_REASONING_EFFORT=
# Set false for a small local model that cannot reliably complete tool-call
# planning. Retrieval and all normal platform APIs remain available.
LLM_TOOL_CALLING_ENABLED=true
# Tool-calling rounds allowed per Copilot turn before it answers with what it has.
LLM_MAX_TOOL_ITERATIONS=4

# Cost accounting written to execution_logs.estimated_cost_usd.
# Zero is correct for a self-hosted model.
LLM_INPUT_COST_PER_1K_USD=0.0
LLM_OUTPUT_COST_PER_1K_USD=0.0

# Copilot retrieval bounds. Retrieval covers governed platform metadata and
# documents the caller may read -- never tenant business rows.
COPILOT_RETRIEVAL_TOP_K=8
COPILOT_CHUNK_CHARS=1200
COPILOT_MAX_DOCUMENT_BYTES_SCANNED=2097152
